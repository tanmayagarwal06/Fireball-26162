# Base URL of the FastAPI backend in ../backend.
# Start it with:  python -m uvicorn app:app --reload --port 8000   (from the backend/ directory)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional. CARTO's tile CDN watermarks keyless requests, so its dark basemaps are only
# offered when a key is set here; without it the console uses the keyless Esri / OSM tiles.
# VITE_CARTO_API_KEY=
